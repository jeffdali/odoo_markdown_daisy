<templates xml:space="preserve">
    <t t-name="odoo_markdown_daisy.MarkdownEditor" owl="1">
        <div class="o_markdown_editor_wrapper w-100">
            <t t-if="props.readonly">
                <div class="o_field_markdown_viewer w-100" t-out="renderedMarkdown"/>
            </t>
            <t t-else="">
                <div class="o_field_markdown_editor_container w-100">
                    <textarea t-ref="textarea"/>
                </div>
            </t>
        </div>
    </t>
</templates>

<templates xml:space="preserve">
    <t t-name="odoo_markdown_daisy.MarkdownPreviewField" owl="1">
        <div class="o_field_markdown_preview_container d-flex align-items-center justify-content-between gap-2 w-100" t-att-title="plainSnippet">
            <div class="o_field_markdown_preview_wrapper text-truncate flex-grow-1" t-out="renderedPreview"/>
            <button t-if="hasContent"
                    type="button"
                    class="btn btn-sm btn-outline-secondary flex-shrink-0 o_markdown_preview_btn py-0 px-2"
                    title="Open Full Markdown Preview"
                    aria-label="Open Full Markdown Preview"
                    t-on-click.stop.prevent="openPreviewDialog">
                <i class="fa fa-eye me-1"/>Preview
            </button>
        </div>
    </t>
</templates>
